{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/static/chatgpt-dinner-plan.schema.json",
  "title": "Meal Planner ChatGPT Dinner Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meal_days"],
  "properties": {
    "schema_version": {
      "const": "mealplanner.chatgpt_dinner_plan.v1"
    },
    "meal_days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "dinner"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "is_starred": {
            "type": "boolean"
          },
          "is_sammy_working": {
            "type": "boolean"
          },
          "dinner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "cooking_user": {
                "type": ["string", "null"],
                "enum": ["Joey", "Sam", null]
              },
              "is_favorite": {
                "type": "boolean",
                "default": false
              },
              "is_takeout": {
                "type": "boolean",
                "default": false
              },
              "is_leftover": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
